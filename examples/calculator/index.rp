# ============================================
# Calculator — Interactive Mode
# Uses rupa.io for user input
# ============================================

import input, toNumber from rupa.io
import calculate from ./modules.op

# ── Display menu ──

print("╔══════════════════════════╗")
print("║   Rupa Calculator v1.0   ║")
print("╚══════════════════════════╝")
print("")
print("Operators: +, -, *, /, %")
print("Type 'q' to quit")
print("")

# ── Interactive loop ──

running = true

while running {
    a_str = input("First number: ")
    if a_str == "q" {
      running = false
      return false
    }

    op = input("Operator (+, -, *, /, %): ")
    if op == "q" {
      running = false
      return false
    }

    b_str = input("Second number: ")
    if b_str == "q" {
      running = false
      return false
    }

    a = toNumber(a_str)
    b = toNumber(b_str)

    if a == null:
      print("Invalid number: " + a_str)

    if b == null:
      print("Invalid number: " + b_str)
      
    if a != null && b != null {
      result = calculate(a, op, b)

      if result != null:
        print("{a} {op} {b} = {result}")
    }
    print("")
}

print("Goodbye!")
