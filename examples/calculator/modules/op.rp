import math from rupa
# ── Calculate using case ──

calculate(x: number, op: string, y: number) {
  case op => {
    "+":  return math.add(x, y)
    "-": return math.sub(x, y)
    "*": return math.mul(x, y)
    "/": return math.div(x, y)
    "%": return math.mod(x, y)
    default: {
      print("Unknown operator: {op}")
      return null
    }
  }
}

export op
