import stdstring from rupa

/**
 * render — suntik konten ke elemen dari resources (file .rpx di disk
 * tidak pernah ditulis). Hasil hanya hidup di memori / respons server.
 */

/* Ganti body elemen dengan konten baru → html penuh siap pakai. */
render(el, content) {
  gt = el.html.indexOf(">")
  if gt < 0 {
    return el.html
  }

  sp = el.html.indexOf(" ")
  if sp < 0 || sp > gt {
    tagName = el.html.slice(1, gt)
  } else {
    tagName = el.html.slice(1, sp)
  }

  close = "</" + tagName + ">"
  bodyEnd = el.html.length - close.length
  if bodyEnd < gt + 1 {
    return el.html
  }

  head = el.html.slice(0, gt + 1)
  tail = el.html.slice(bodyEnd, el.html.length)
  return head + content + tail
}
