import fs, os, stdstring, spec from rupa

/**
 * resources — builtin view engine: marker id="@name" pada HTML murni.
 *
 * Bila dijalankan via `rupa go` (spec.root tersedia): SEMUA file .rpx di
 * folder res/ (rekursif ke subfolder) dipindai OTOMATIS saat modul dimuat.
 * Consumer cukup pakai r.id.<name> — tidak ada r.load(...) publik.
 *
 * Bila di luar `rupa go` (spec.root kosong): fallback ke os.scriptdir
 * (folder engine); load(relative) tetap ada sebagai jalur internal.
 *
 * id="@name" bersifat TUNGGAL — dua marker dengan nama sama = error.
 */

/* Path aset/template relatif terhadap file skrip ini (fallback). */
const localRoot = os.scriptdir() + "/"

/* Root project dari .spec (rupa go) — null di luar go. */
const projectRoot = spec.root

/* indexOf absolut pertama needle pada html mulai offset from. */
findFrom(html, from, needle) {
  tail = html.slice(from, html.length)
  rel = tail.indexOf(needle)
  if rel < 0 {
    return -1
  }
  return from + rel
}

/* Posisi '<' terakhir SEBELUM limit — via split("<"), tanpa arg start. */
lastLtBefore(html, limit) {
  parts = html.split("<")
  last = -1
  pos = parts[0].length
  k = 1
  while k < parts.length {
    if pos >= 0 && pos < limit {
      last = pos
    }
    pos = pos + 1 + parts[k].length
    k = k + 1
  }
  return last
}

/* Nama marker pada open tag ("" bila bukan marker). */
markerNameIn(tag) {
  m = tag.indexOf("id=\"@")
  if m < 0 {
    return ""
  }
  rest = tag.slice(m + 5, tag.length)
  ne = rest.indexOf("\"")
  if ne < 0 {
    return ""
  }
  return rest.slice(0, ne)
}

/* Nama tag dari open tag. */
tagNameIn(tag) {
  sp = tag.indexOf(" ")
  if sp < 0 {
    return tag.slice(1, tag.length)
  }
  return tag.slice(1, sp)
}

/* Scan satu html → tambah marker ke ids. Duplikat id = error.
 * Return: -1 bila fatal, 0 OK. */
scanHtml(html, ids, source) {
  i = findFrom(html, 0, "id=\"@")
  while i >= 0 {
    elemStart = lastLtBefore(html, i)
    if elemStart < 0 {
      i = -1
    } else {
      gt = findFrom(html, elemStart, ">")
      tag = html.slice(elemStart, gt + 1)
      name = markerNameIn(tag)

      if len(name) == 0 {
        i = findFrom(html, i + 5, "id=\"@")
      } else {
        if ids.has(name) {
          print("resources: duplikat id=\"@" + name + "\" di " + source)
          return -1
        }
        if tag.endsWith("/>") {
          end = gt + 1
          tagName = tag.slice(1, tag.length - 2)
          body = ""
        } else {
          tagName = tagNameIn(tag)
          cl = findFrom(html, gt, "</" + tagName + ">")
          if cl < 0 {
            end = gt + 1
            body = ""
          } else {
            end = cl + tagName.length + 3
            body = html.slice(gt + 1, end - tagName.length - 3)
          }
        }

        el = new Object()
        el.set("name", name)
        el.set("tag", tagName)
        el.set("open", tag)
        el.set("body", body)
        el.set("html", html.slice(elemStart, end))
        el.set("pos", elemStart)
        el.set("end", end)
        el.set("source", source)
        ids.set(name, el)

        i = findFrom(html, i + 5, "id=\"@")
      }
    }
  }
  return 0
}

/* Scan folder secara rekursif: semua *.rpx dipindai ke ids.
 * Return: -1 bila fatal (duplikat/baca gagal), 0 OK. */
scanDir(dir, rel, ids) {
  files = os.listdir(dir)
  fi = 0
  while fi < files.length {
    fname = files[fi]
    full = dir + "/" + fname
    rpath = rel + "/" + fname
    if fs.isDir(full) {
      if scanDir(full, rpath, ids) != 0 {
        return -1
      }
    } else {
      if fname.endsWith(".rpx") {
        html = fs.read(full)
        if scanHtml(html, ids, rpath) != 0 {
          return -1
        }
      }
    }
    fi = fi + 1
  }
  return 0
}

/* Internal (di luar rupa go): muat satu file relatif ke engine. */
load(relative) {
  full = localRoot + relative
  if !fs.exists(full) {
    return {ok: false, error: "template not found: " + full}
  }
  html = fs.read(full)
  ids = new Object()
  if scanHtml(html, ids, relative) != 0 {
    return {ok: false, error: "duplicate id in " + relative}
  }
  return {ok: true, ids: ids}
}

/* --- auto-scan: semua .rpx di res/ (rekursif) dari project root --- */
id = new Object()
if type(projectRoot) == "string" {
  resDir = projectRoot + "/res"
  if fs.exists(resDir) {
    if scanDir(resDir, "res", id) != 0 {
      print("resources: scan dihentikan (duplikat id)")
    }
  }
}
