import db from ./database

loader() {
  if this.status == AWAIT {
    print("loading...\n")
  } else if this.status == SUCCESS {
    print("data: ")
    print(this.data)
    print("\n")
  } else {
    print("error: ")
    print(this.error)
    print("\n")
  }
}

async db.getUser() -> { loader, 5000 }
