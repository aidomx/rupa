# Simple function returning string
getStr() {
    return "hello"
}
s = getStr()
print(s + "\n")

# Function returning number
getNum() {
    return 42
}
n = getNum()
print(n + "\n")

# Function returning object
getObj() {
    return { name: "test", age: 10 }
}
o = getObj()
print(o.name + "\n")
print(o.age + "\n")
