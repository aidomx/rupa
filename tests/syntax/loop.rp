i = 10
for i: print(i)
rev i: print(i)

for i < 10: print(i)
rev i > 0: print(i)

for i < 10 {
    print(i)
}

rev i >= 0 {
    print(i)
}

while x < 10: print(x)

while x < 10 {
    print(x)
    x++
}

for i < 10 {
  if i == 1: continue
  if i == 8: break
  print(i)
}

for i < 10 {
  if i == 1: continue
  if i == 8: break
  print(i)
}

for i < 3 {
  i++
  i--
}
