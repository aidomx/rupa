# @input marker (design/new_class.txt poin 5).
# - `@input` di atas method MENGAKTIFKAN main.input: Input.
# - Return value handler = deklarasi strict field yang boleh diinput
#   (key = nama field, value = prompt string).
# - `input.get("...")` STRICT: field di luar deklarasi = ReferenceError.
# - construct dengan param `input` menerima object Input saat
#   instantiation; construct ber-param input tidak jalan saat deklarasi
#   class (belum ada program yang memakai).
#
# Test ini deterministic tanpa stdin interaktif: handler dijalankan,
# spec terdaftar; get tidak dipanggil di sini (butuh stdin), yang
# diverifikasi hanya struktur + lifecycle handler.
// ambil semua yang di export dari io
// dan tanpa namespace io untuk menggunakan
// io.toNumber() akses langsung toNumber()
import toNumber from rupa.io

// struct Monster
MonsterType {
  name: string
  health: number
}
// class Monster
Monster: MonsterType {
  construct(input: Input) {
    this.set({
      name: input.get("name"),
      health: toNumber(input.get("health"))
    })
  }

  @input
  handler() {
    return {
      name: "Input monster name: ",
      health: "Input monster health: "
    }
  }
}

print("ready")
