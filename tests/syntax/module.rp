// module.rp — semantik dotted path (design/ie.txt import #5)
// Hanya modules.a yang terjangkau: satu-satunya leaf dengan statement
// export (`export *`). Leaf tanpa export (b/c/d) tidak bisa diakses via
// dotted path — Z-self wajib mengekspor dirinya, kalau tidak resolusi
// gagal dengan ImportError (cek manual: import d from ../modules.d).
import create, update from ../modules.a
import os from rupa
import db, math from rupa

print(db)

print(math + "\n")
print(math.add(1, 2) + "\n")

create()
update()
print(os.info().user + "\n")
