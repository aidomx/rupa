import dbtest from rupa
import thread from rupa

loader() {
  if this.status == AWAIT {
    print("loading...\n")
  } else if this.status == SUCCESS {
    print(this.data, "\n")
  } else {
    print(this.error, "\n")
  }
}

slowGetUsers() {
  thread.sleep(200)
  return dbtest.getUser()
}

// Fast request with long timeout → SUCCESS
async dbtest.getUser() -> { loader, 5000 }

// Slow request with short timeout → ERROR
async slowGetUsers() -> { loader, 50 }
