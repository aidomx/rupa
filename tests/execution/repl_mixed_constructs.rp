# Mixed: variables, functions, objects, arrays in sequence
x = 10
y = 20
# Define helper
assertEq(x + y, 30)
square(n) {
  return n * n
}
# Object construction
assertEq(square(x), 100)
config = {host: "localhost", port: 8080, debug: true}
# Array operations
# Function using object and array
assertEq(config.host, "localhost")
assertEq(config.port, 8080)
assert(config.debug)
nums = [1, 2, 3, 4, 5]
total = 0
for i < 5 {
  total = total + nums[i]
}
assertEq(total, 15)
getConfig() {
  return {host: "localhost", port: 8080}
}
cfg = getConfig()
assertEq(cfg.host, "localhost")
