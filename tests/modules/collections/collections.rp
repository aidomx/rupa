// collections.rp — Collection utility functions
// Import: import collections from rupa

map(arr, fn) {
  result = []
  i = 0
  while i < len(arr) {
    result.push(fn(arr[i]))
    i = i + 1
  }
  return result
}

filter(arr, fn) {
  result = []
  i = 0
  while i < len(arr) {
    if fn(arr[i]) {
      result.push(arr[i])
    }
    i = i + 1
  }
  return result
}

reduce(arr, fn, initial) {
  acc = initial
  i = 0
  while i < len(arr) {
    acc = fn(acc, arr[i])
    i = i + 1
  }
  return acc
}

find(arr, fn) {
  i = 0
  while i < len(arr) {
    if fn(arr[i]): return arr[i]
    i = i + 1
  }
  return null
}

some(arr, fn) {
  i = 0
  while i < len(arr) {
    if fn(arr[i]): return true
    i = i + 1
  }
  return false
}

every(arr, fn) {
  i = 0
  while i < len(arr) {
    if !fn(arr[i]): return false
    i = i + 1
  }
  return true
}

sum(arr) {
  total = 0
  i = 0
  while i < len(arr) {
    total = total + arr[i]
    i = i + 1
  }
  return total
}

unique(arr) {
  result = []
  i = 0
  while i < len(arr) {
    found = false
    j = 0
    while j < len(result) {
      if result[j] == arr[i] {
        found = true
        break
      }
      j = j + 1
    }
    if !found {
      result.push(arr[i])
    }
    i = i + 1
  }
  return result
}

sort(arr) {
  result = []
  i = 0
  while i < len(arr) {
    result.push(arr[i])
    i = i + 1
  }
  i = 0
  while i < len(result) {
    j = 0
    while j < len(result) - 1 - i {
      if result[j] > result[j + 1] {
        temp = result[j]
        result[j] = result[j + 1]
        result[j + 1] = temp
      }
      j = j + 1
    }
    i = i + 1
  }
  return result
}

chunk(arr, size) {
  result = []
  i = 0
  while i < len(arr) {
    group = []
    j = 0
    while j < size && i + j < len(arr) {
      group.push(arr[i + j])
      j = j + 1
    }
    result.push(group)
    i = i + size
  }
  return result
}
