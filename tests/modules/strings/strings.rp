// string_utils.rp — String utility functions
// Import: import string_utils from rupa

startsWith(str, prefix) {
  if len(str) < len(prefix): return false
  i = 0
  while i < len(prefix) {
    if str[i] != prefix[i]: return false
    i = i + 1
  }
  return true
}

endsWith(str, suffix) {
  if len(str) < len(suffix): return false
  offset = len(str) - len(suffix)
  i = 0
  while i < len(suffix) {
    if str[offset + i] != suffix[i]: return false
    i = i + 1
  }
  return true
}

repeat(str, n) {
  result = ""
  i = 0
  while i < n {
    result = result + str
    i = i + 1
  }
  return result
}

reverse(str) {
  result = ""
  i = len(str) - 1
  while i >= 0 {
    result = result + str[i]
    i = i - 1
  }
  return result
}

contains(str, sub) {
  if len(sub) > len(str): return false
  i = 0
  while i <= len(str) - len(sub) {
    j = 0
    found = true
    while j < len(sub) {
      if str[i + j] != sub[j] {
        found = false
        break
      }
      j = j + 1
    }
    if found: return true
    i = i + 1
  }
  return false
}

trim(str) {
  start = 0
  while start < len(str) && str[start] == " " {
    start = start + 1
  }
  end = len(str) - 1
  while end >= start && str[end] == " " {
    end = end - 1
  }
  result = ""
  i = start
  while i <= end {
    result = result + str[i]
    i = i + 1
  }
  return result
}
