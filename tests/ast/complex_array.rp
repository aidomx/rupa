# Simple array
nums = [1, 2, 3, 4, 5]

# Array with mixed types
mixed = [1, "hello", true, 3.14]

# Nested arrays
nested = [[1, 2], [3, 4], [5, 6]]

# Array with expressions
computed = [1 + 2, 3 * 4, 10 / 2]

# Array subscript
first = nums[0]
second = nums[1]

# Nested subscript
matrix = [[1, 2], [3, 4]]
val = matrix[0][1]

# Array with function calls
results = [add(1, 2), add(3, 4)]
