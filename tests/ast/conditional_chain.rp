# Conditional assignment
result ?= valid -> "Sukses"

# Conditional with fallback
value ?= check -> primary | fallback

# If statement
if true {
    x = 1
}

# If-else
if false {
    x = 1
} else {
    x = 2
}

# Function with conditional
check(v) {
    if v {
        return "yes"
    } else {
        return "no"
    }
}

# Annotation with value
count: number = 42
name: string = "test"
active: boolean = true
