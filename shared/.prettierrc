{
  "trailingComma": "none",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "bracketSpacing": true,
  "printWidth": 80,
  "arrowParens": "avoid",
  "overrides": [
    {
      "files": "*.{c,h,sh}",
      "options": {
        "tabWidth": 2,
        "singleQuote": false
      }
    }
  ]
}
